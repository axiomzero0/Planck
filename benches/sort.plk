// Benchmark: bottom-up mergesort over xorshift-generated keys.
// Generated by benches/gen_sources.py -- do not edit by hand.
// Exercises: loops, i64 checked arithmetic, xorshift bit ops, index bounds
// checks, borrow passing, and the merge/copy memory traffic pattern.
fn fill(a: &mut [i32; 512], seed: i64) -> () {
    let mut x: i64 = seed;
    for i in 0..512 {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        (*a)[i] = (x & 65535) as i32;
    }
}
fn min2(a: i32, b: i32) -> i32 {
    if a < b { return a; }
    return b;
}
fn merge(a: &mut [i32; 512], t: &mut [i32; 512], lo: i32, mid: i32, hi: i32) -> () {
    let mut i: i32 = lo;
    let mut j: i32 = mid;
    let mut k: i32 = lo;
    while i < mid && j < hi {
        if (*a)[i] <= (*a)[j] {
            (*t)[k] = (*a)[i];
            i = i + 1;
        } else {
            (*t)[k] = (*a)[j];
            j = j + 1;
        }
        k = k + 1;
    }
    while i < mid {
        (*t)[k] = (*a)[i];
        i = i + 1;
        k = k + 1;
    }
    while j < hi {
        (*t)[k] = (*a)[j];
        j = j + 1;
        k = k + 1;
    }
}
fn copy_back(t: &mut [i32; 512], a: &mut [i32; 512]) -> () {
    for i in 0..512 {
        (*a)[i] = (*t)[i];
    }
}
fn checksum(a: &[i32; 512]) -> i64 {
    let mut s: i64 = 0;
    for i in 0..512 {
        s = s + (*a)[i] as i64 * (i as i64 + 1);
    }
    return s;
}
