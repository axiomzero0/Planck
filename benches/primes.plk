// Benchmark: count primes below 200000 by trial division.
// Exercises: i64 checked arithmetic, the remainder path (including the
// MinInt/-1 hardware guard), nested loops with early returns, i32 counters.
fn is_prime(n: i64) -> bool {
    if n < 2 {
        return false;
    }
    if n % 2 == 0 {
        return n == 2;
    }
    let mut d: i64 = 3;
    while d * d <= n {
        if n % d == 0 {
            return false;
        }
        d = d + 2;
    }
    return true;
}

fn main() -> i32 {
    let limit: i32 = 200000;
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < limit {
        if is_prime(i as i64) {
            count = count + 1;
        }
        i = i + 1;
    }
    print(count);
    print('\n');
    return 0;
}
