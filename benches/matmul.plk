struct Mat { d: [i32; 2304] }
fn fill(m: &mut Mat, seed: i64) -> () {
    let mut x: i64 = seed;
    for i in 0..2304 {
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        (*m).d[i] = (x & 1023) as i32;
    }
}
fn mul(a: &Mat, b: &Mat, out: &mut Mat) -> () {
    for i in 0..48 {
        for k in 0..48 {
            let av: i32 = (*a).d[i * 48 + k];
            for j in 0..48 {
                (*out).d[i * 48 + j] = (*out).d[i * 48 + j] + av * (*b).d[k * 48 + j];
            }
        }
    }
}
fn checksum(m: &Mat) -> i64 {
    let mut s: i64 = 0;
    for i in 0..2304 {
        s = s + (*m).d[i] as i64 * (i as i64 + 1);
    }
    return s;
}
